{
  "name": "floor-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drives hundreds of wallets through the FLOOR Program with @floor/sdk: the testnet soak harness",
  "bin": {
    "swarm": "./bin/swarm.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --no-warnings 'test/unit/**/*.test.ts'",
    "test:local": "node --test --no-warnings --test-concurrency=1 'test/local/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.57.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
